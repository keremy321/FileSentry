@FileSentry.Api_HostAddress = http://localhost:5029
@AccessToken = replace-with-access-token

GET {{FileSentry.Api_HostAddress}}/health/live
Accept: application/json

###

GET {{FileSentry.Api_HostAddress}}/health/ready
Accept: application/json

###

POST {{FileSentry.Api_HostAddress}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "replace-with-a-strong-password"
}

###

POST {{FileSentry.Api_HostAddress}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "replace-with-a-strong-password"
}

###

GET {{FileSentry.Api_HostAddress}}/api/v1/auth/me
Authorization: Bearer {{AccessToken}}
Accept: application/json

###
