{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ClamAV": {
    "Host": "127.0.0.1",
    "Port": 3310,
    "TimeoutSeconds": 5
  },
  "Jwt": {
    "Issuer": "FileSentry.Api",
    "Audience": "FileSentry.Client",
    "AccessTokenLifetimeMinutes": 15
  },
  "AuthenticationRateLimit": {
    "PermitLimit": 10,
    "WindowSeconds": 60
  },
  "Storage": {
    "RootPath": "../../data"
  },
  "AllowedHosts": "*"
}
