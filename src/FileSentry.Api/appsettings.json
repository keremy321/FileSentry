{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ClamAV": {
    "Host": "127.0.0.1",
    "Port": 3310,
    "TimeoutSeconds": 5,
    "ScanTimeoutSeconds": 30,
    "MaximumStreamSizeBytes": 10485760,
    "StreamChunkSizeBytes": 65536
  },
  "ScannerWorker": {
    "Enabled": true,
    "MaximumAttempts": 3,
    "InitialRetryDelaySeconds": 5,
    "MaximumRetryDelaySeconds": 60,
    "StuckJobTimeoutSeconds": 120,
    "PollingIntervalMilliseconds": 1000
  },
  "Jwt": {
    "Issuer": "FileSentry.Api",
    "Audience": "FileSentry.Client",
    "AccessTokenLifetimeMinutes": 15
  },
  "AuthenticationRateLimit": {
    "PermitLimit": 10,
    "WindowSeconds": 60
  },
  "Storage": {
    "RootPath": "../../data"
  },
  "AllowedHosts": "*"
}
